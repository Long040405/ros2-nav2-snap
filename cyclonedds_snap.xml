<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS>
  <Domain>
    <General>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>100</MaxAutoParticipantIndex>
      <Peers>
        <Peer Address="192.168.1.1"/>      <!-- ctrlX CORE -->
        <Peer Address="192.168.1.20"/>     <!-- Laptop LAN (Primary) -->
        <Peer Address="192.168.1.10"/>     <!-- Laptop LAN (Secondary) -->
        <Peer Address="127.0.0.1"/>        <!-- Localhost loopback -->
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
